{
  "name": "badat-football",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite client --host 0.0.0.0 --port 4215",
    "db:setup": "psql -d postgres -f db/setup.sql",
    "db:reset": "psql -d postgres -f db/setup.sql && psql -d badat_football -f db/schema.sql && psql -d badat_football -f db/seed.sql",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:logs": "pm2 logs badat-api badat-web"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "libphonenumber-js": "^1.13.13",
    "lucide-react": "^0.468.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.7"
  }
}
